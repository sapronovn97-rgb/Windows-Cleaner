<Window
    x:Class="WinChecker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:WinChecker"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Spacing="20" Margin="32">
            <TextBlock Text="Панель Управления Windows Checker" FontSize="24" FontWeight="Bold" />

            <!-- Секция Диагностика Железа -->
            <StackPanel Orientation="Vertical" Spacing="8">
                <TextBlock Text="Диагностика системы и железа" FontSize="14" Foreground="Gray"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="CheckButton" Content="Проверить ПК и Диски" Click="CheckButton_Click" />
                    <Button x:Name="NetButton" Content="Проверить Сеть (IP)" Click="NetButton_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Секция Обслуживание и Оптимизация -->
            <StackPanel Orientation="Vertical" Spacing="8">
                <TextBlock Text="Обслуживание и Оптимизация" FontSize="14" Foreground="Gray"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="CleanButton" Content="Очистить файлы Temp" Click="CleanButton_Click" />
                    <Button x:Name="DnsButton" Content="Сбросить DNS Кэш" Click="DnsButton_Click" />
                    <Button x:Name="SfcButton" Content="Проверить файлы системы (SFC)" Click="SfcButton_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Прогресс-бар -->
            <ProgressBar x:Name="AppProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Height="4" />

            <!-- Информационные блоки -->
            <StackPanel Spacing="8">
                <TextBlock Text="ОТЧЕТ РАБОТЫ И СТАТУС" FontSize="16" FontWeight="SemiBold" Foreground="Gray"/>
                <TextBlock x:Name="SystemInfoText" Text="Нажмите любую кнопку для выполнения действия." TextWrapping="Wrap" FontSize="14" />
                <TextBlock x:Name="RamInfoText" TextWrapping="Wrap" FontSize="14" />
                <TextBlock x:Name="DiskInfoText" TextWrapping="Wrap" FontSize="14" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
